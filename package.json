{
  "name": "@garoon/mcp-server",
  "version": "1.3.2",
  "description": "The official MCP Server for Garoon",
  "keywords": [
    "garoon",
    "mcp",
    "modelcontextprotocol"
  ],
  "homepage": "https://github.com/garoon/garoon-mcp-server",
  "bugs": {
    "url": "https://github.com/garoon/garoon-mcp-server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garoon/garoon-mcp-server.git"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Cybozu, Inc.",
    "url": "https://cybozu.co.jp"
  },
  "type": "module",
  "imports": {
    "#applications/*.js": {
      "types": "./src/applications/*.ts",
      "development": "./src/applications/*.ts",
      "default": "./dist/applications/*.js"
    },
    "#core/*.js": {
      "types": "./src/core/*.ts",
      "development": "./src/core/*.ts",
      "default": "./dist/core/*.js"
    },
    "#schemas/*.js": {
      "types": "./src/schemas/*.ts",
      "development": "./src/schemas/*.ts",
      "default": "./dist/schemas/*.js"
    },
    "#client.js": {
      "types": "./src/client.ts",
      "development": "./src/client.ts",
      "default": "./dist/client.js"
    },
    "#config.js": {
      "types": "./src/config.ts",
      "development": "./src/config.ts",
      "default": "./dist/config.js"
    },
    "#constants.js": {
      "types": "./src/constants.ts",
      "development": "./src/constants.ts",
      "default": "./dist/constants.js"
    }
  },
  "main": "dist/index.js",
  "bin": {
    "garoon-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "dev": "./scripts/run-inspector.sh",
    "prebuild": "node scripts/generate-build-constants.js",
    "build": "tsc",
    "build:mcpb": "./scripts/build-mcpb.sh",
    "check:mcpb": "mcpb validate .",
    "clean": "pnpm \"/^clean:.*/\"",
    "clean:dist": "rm -rf dist",
    "clean:mcpb": "rm -rf build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "lint": "pnpm run \"/^lint:.*/\"",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:prettier": "prettier --check '**/*.{json,json5,md,yml,yaml}' --cache",
    "fix": "pnpm run \"/^fix:.*/\"",
    "fix:eslint": "pnpm lint:eslint --fix",
    "fix:prettier": "pnpm lint:prettier --write",
    "license:analyze": "license-manager analyze -c license-manager.config.cjs",
    "license:extract": "license-manager extract -c license-manager.config.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@modelcontextprotocol/server": "^2.2.0",
    "undici": "^8.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@cybozu/eslint-config": "^25.0.0",
    "@cybozu/license-manager": "^1.4.0",
    "@modelcontextprotocol/client": "^2.2.0",
    "@modelcontextprotocol/inspector": "^2.7.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "ajv": "^8.20.0",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@10.34.7+sha512.ba98abc585539933375b5971f4bc6d6c73a1b4b7edc4a879e7d102fe5423d1e02309d67c60a11f04955093a96e521ad9c3b138cdd654ca5be563f378b3ae48bd"
}
